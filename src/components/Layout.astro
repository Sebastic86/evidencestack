---
import '@fontsource/libre-franklin/400.css';
import '@fontsource/libre-franklin/500.css';
import '@fontsource/libre-franklin/600.css';
import '@fontsource/libre-franklin/700.css';
import '@fontsource/libre-franklin/800.css';
import '@fontsource/fragment-mono/400.css';
import '../styles/global.css';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { SITE_NAME, NOINDEX } from '../config';
import { serializeJsonLd } from '../lib/jsonld';

interface Props {
  title: string;
  description: string;
  /**
   * Optional schema.org node (or array of them) for this page, built by
   * `src/lib/jsonld.ts`. Serialised there, not here — see that file for what
   * this site deliberately does not assert in structured data.
   */
  jsonLd?: unknown;
}
const { title, description, jsonLd } = Astro.props;
// The JSON-LD block below must use `set:html`. As a plain child expression Astro
// would HTML-escape every quote in the JSON and emit an unparseable block — and
// nothing short of a browser would notice. `is:inline` keeps the bundler off it.
const fullTitle = title === SITE_NAME ? title : `${title} — ${SITE_NAME}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const favicon =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%231c2b24'/%3E%3Crect x='5' y='6' width='22' height='5' fill='%234fae74'/%3E%3Crect x='5' y='13.5' width='15' height='5' fill='%233d8f5e'/%3E%3Crect x='5' y='21' width='9' height='5' fill='%232e6f49'/%3E%3C/svg%3E";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {/* Beta. Removed by setting NOINDEX to false in src/config.ts — see the note there. */}
    {NOINDEX && <meta name="robots" content="noindex, nofollow, noarchive" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={favicon} />
    {!NOINDEX && <link rel="sitemap" href="/sitemap-index.xml" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    {
      jsonLd && (
        <script type="application/ld+json" is:inline set:html={serializeJsonLd(jsonLd)}></script>
      )
    }
  </head>
  <body>
    <div class="page">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style>
  .page { min-height: 100vh; display: flex; flex-direction: column; }
  main {
    flex: 1;
    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 24px;
  }
</style>

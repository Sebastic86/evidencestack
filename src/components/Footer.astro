---
import Logo from './Logo.astro';
import { BUTTONDOWN_USERNAME, DISCLAIMER } from '../config';

// Buttondown's embed endpoint must be a plain form action — it sends no CORS
// headers, so posting to it with fetch() is blocked by the browser.
const subscribeAction = `https://buttondown.com/api/emails/embed-subscribe/${BUTTONDOWN_USERNAME}`;
---

<footer>
  <div class="inner">
    <div class="brand-row">
      <Logo size={20} variant="muted" />
      <span class="wordmark"><span class="w1">Evidence</span><span class="w2">STACK</span></span>
    </div>
    <div class="pitch">
      <div class="pitch-title">One email when a grade moves.</div>
      <div class="pitch-sub">No news feed, no digests — regrade events only.</div>
    </div>
    <form action={subscribeAction} method="post" class="subscribe">
      <input type="hidden" name="embed" value="1" />
      <label class="sr-only" for="newsletter-email">Email address</label>
      <input
        id="newsletter-email"
        type="email"
        name="email"
        placeholder="you@example.com"
        required
      />
      <button type="submit">SUBSCRIBE</button>
    </form>
    <div class="disclaimer">{DISCLAIMER}</div>
  </div>
</footer>

<style>
  footer {
    border-top: 2px solid var(--ink);
    background: var(--paper);
    margin-top: auto;
  }
  .inner {
    max-width: 1080px;
    margin: 0 auto;
    padding: 24px;
    display: flex;
    gap: 24px;
    align-items: center;
    flex-wrap: wrap;
  }
  .brand-row { flex: 1 1 100%; display: flex; align-items: center; gap: 9px; }
  .wordmark { display: flex; align-items: baseline; gap: 6px; }
  .w1 { font-size: 15px; font-weight: 800; color: var(--ink); }
  .w2 {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--green-text);
  }
  .pitch { flex: 1 1 320px; }
  .pitch-title { font-size: 14px; font-weight: 700; }
  .pitch-sub { font-size: 12px; color: var(--muted); margin-top: 2px; }
  .disclaimer {
    flex: 1 1 100%;
    font-family: var(--mono);
    font-size: 10px;
    color: var(--muted-2);
  }
  .subscribe { display: flex; gap: 8px; flex: 1 1 300px; }
  .subscribe input[type='email'] {
    flex: 1;
    min-width: 0;
    padding: 9px 12px;
    font-size: 13px;
    border: 1px solid var(--line-input);
    background: white;
    font-family: var(--mono);
  }
  .subscribe button {
    padding: 9px 16px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    border: 2px solid var(--green);
    box-shadow: 4px 4px 0 var(--ink);
    background: var(--green);
    color: white;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

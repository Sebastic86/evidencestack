---
import Layout from '../../components/Layout.astro';
import ClaimsBlock from '../../islands/ClaimsBlock';
import { StudyCard } from '../../components/ui';
import { allCompounds, costSnapshot } from '../../lib/data';
import { formatEurPerGram } from '../../lib/cost';
import { compoundDataset } from '../../lib/jsonld';

export async function getStaticPaths() {
  const compounds = await allCompounds();
  return compounds.map((c) => ({ params: { id: c.id }, props: { compound: c } }));
}

const { compound } = Astro.props;
const d = compound.data;
// Null while there are no product records for this compound. The cost strip is
// then omitted entirely rather than shown empty; it returns when a record exists.
const cost = await costSnapshot(compound.id);
const bestClaim = d.claims[0]!;
const studyCount = d.claims.reduce((a, c) => a + c.studies.length, 0);
const description = `${d.name} — ${bestClaim.outcome}: evidence grade ${bestClaim.grade}, ${bestClaim.effect} effect. ${d.claims.length} claims graded against ${studyCount} studies.`;
const reviewedDate = d.reviewed.toISOString().slice(0, 10);

// A `Dataset` subset of the register, not an `Article` — nobody has authored or
// signed this record off, and `reviewer` still reads "draft — unverified". The
// builder carries that marker through as `creativeWorkStatus`, so the markup
// says the same thing the byline on this page says.
const jsonLd = compoundDataset(
  {
    id: compound.id,
    name: d.name,
    blurb: d.blurb,
    cats: d.cats,
    reviewer: d.reviewer,
    claimCount: d.claims.length,
    studyCount,
  },
  Astro.site,
);
---

<Layout title={d.name} description={description} jsonLd={jsonLd}>
  <div class="detail">
    <a href="/compounds/" class="back">← REGISTER</a>

    <div class="head">
      <div class="head-main">
        <h1>{d.name}</h1>
        <div class="forms">{d.forms}</div>
        <p class="blurb">{d.blurb}</p>
      </div>
      <div class="reviewed">
        <div>last reviewed {reviewedDate}</div>
        <div>by {d.reviewer}</div>
      </div>
    </div>

    <ClaimsBlock client:load claims={d.claims} />
    <noscript>
      {d.claims.map((c) => (
        <section>
          <h2 style="font-size: 16px; margin: 12px 0 8px">
            {c.outcome} — grade {c.grade}, {c.effect} effect ({c.species})
          </h2>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 12px">
            {c.studies.map((s) => (
              <StudyCard study={s} />
            ))}
          </div>
        </section>
      ))}
    </noscript>

    <div class="two-col">
      <div class="card">
        <div class="card-label">Grade timeline</div>
        {
          d.history.length > 0 ? (
            d.history.map((t) => (
              <div class="timeline-row">
                <div class:list={['timeline-date', t.kind === 'reaffirmed' && 'held']}>{t.date}</div>
                <div>
                  <div class="timeline-move">
                    {t.claim}:{' '}
                    {t.kind === 'reaffirmed' ? (
                      <Fragment>
                        {t.to} held<span class="timeline-tag">REAFFIRMED</span>
                      </Fragment>
                    ) : (
                      <Fragment>
                        {t.from} → {t.to}
                      </Fragment>
                    )}
                  </div>
                  <div class="timeline-why">{t.why}</div>
                </div>
              </div>
            ))
          ) : (
            <div class="empty-note">No grade movement since first review.</div>
          )
        }
      </div>
      <div class="card">
        <div class="card-label">Dosing &amp; safety</div>
        <div class="dosing">
          <div><span class="dose-label">TYPICAL SUPPLEMENT DOSE</span>{d.typicalDose}</div>
          <div><span class="dose-label">DOSES USED IN STUDIES</span>{d.studiedDose}</div>
          <div><span class="dose-label">UPPER LIMIT</span>{d.ul}</div>
          {
            d.caution && (
              <div class="caution">
                <span class="dose-label caution-label">SAFETY NOTE</span>
                {d.caution}
              </div>
            )
          }
        </div>
      </div>
    </div>

    {
      cost && (
        <div class="card cost-strip">
          <div class="micro-label">COST SNAPSHOT</div>
          <div class="cost-value">
            <b>{formatEurPerGram(cost.eurPerGram)}</b>
            <span> cheapest per gram of active · {cost.formLabel}</span>
          </div>
          <a href="/tools/cost-per-gram/" class="cost-cta">OPEN CALCULATOR →</a>
        </div>
      )
    }
  </div>
</Layout>

<style>
  /* Bottom room sits on the wrapper, not the cost strip — the strip is absent
     for compounds with no product records. */
  .detail { padding: 24px 0 48px; }
  .back {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--amber);
    text-decoration: none;
  }
  .back:hover { text-decoration: underline; }
  .head {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    flex-wrap: wrap;
    padding: 14px 0 8px;
  }
  .head-main { flex: 1 1 400px; }
  h1 { font-size: 32px; font-weight: 800; }
  .forms {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
    margin: 4px 0 10px;
  }
  .blurb {
    font-size: 15px;
    line-height: 1.55;
    color: var(--body);
    max-width: 620px;
    text-wrap: pretty;
  }
  .reviewed {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    text-align: right;
    padding-top: 8px;
  }
  .two-col {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
    margin-bottom: 28px;
  }
  .timeline-row {
    padding: 12px 16px;
    border-bottom: 1px solid var(--line-soft);
    display: flex;
    gap: 12px;
  }
  .timeline-date {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--green-text);
    font-weight: 700;
    flex: 0 0 64px;
  }
  /* A reaffirmation is not a movement, so it does not take the green the
     timeline uses for grade changes — it steps back to the muted register. */
  .timeline-date.held { color: var(--muted); }
  .timeline-move { font-size: 13px; font-weight: 600; }
  .timeline-tag {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--muted-2);
    border: 1px solid var(--line-mid);
    padding: 1px 5px;
    margin-left: 8px;
    white-space: nowrap;
  }
  .timeline-why {
    font-size: 12px;
    color: oklch(0.45 0.02 160);
    margin-top: 2px;
    line-height: 1.45;
  }
  .empty-note { padding: 14px 16px; font-size: 12px; color: var(--muted); }
  .dosing {
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 13px;
    line-height: 1.5;
  }
  .dose-label {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--muted-2);
    display: block;
  }
  .caution { border-left: 2px solid var(--amber); padding-left: 10px; color: var(--body); }
  .caution-label { color: var(--amber); }
  .cost-strip {
    padding: 14px 20px;
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .cost-value { font-size: 14px; }
  .cost-value span { color: var(--muted); }
  .cost-cta {
    margin-left: auto;
    border: 1px solid var(--line-input);
    padding: 7px 12px;
    font-size: 12px;
    font-family: var(--mono);
    color: var(--ink);
    text-decoration: none;
  }
  .cost-cta:hover { border-color: var(--ink); color: var(--ink); }
</style>
